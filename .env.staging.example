SECRET_KEY="REPLACE_WITH_STAGING_SECRET"
ACCESS_TOKEN_EXPIRE_MINUTES=120

TMD_UID=""
TMD_UKEY=""
TRAFFY_API_KEY=""
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""

MIN_LNG=100.6500
MIN_LAT=13.6500
MAX_LNG=100.9000
MAX_LAT=13.8200
