ENVIRONMENT=staging
DEBUG=false
APP_NAME="KMITL Flood Intelligence (Staging)"
APP_VERSION="1.0.0-rc"
LOG_LEVEL=INFO

DOMAIN=staging.flood.kmitl.ac.th
API_DOMAIN=api-staging.flood.kmitl.ac.th
PORT=8000
ALLOWED_ORIGINS="https://staging.flood.kmitl.ac.th"

DATABASE_URL="postgresql+asyncpg://kmitl_admin:REPLACE_STAGING_PASSWORD@kmitl-flood-db-staging.cluster-xyz.ap-southeast-1.rds.amazonaws.com:5432/kmitl_flood_staging"
DATABASE_SYNC_URL="postgresql://kmitl_admin:REPLACE_STAGING_PASSWORD@kmitl-flood-db-staging.cluster-xyz.ap-southeast-1.rds.amazonaws.com:5432/kmitl_flood_staging"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

REDIS_URL="redis://kmitl-redis-staging.cluster-xyz.cache.amazonaws.com:6379/0"
SQS_QUEUE_URL="https://sqs.ap-southeast-1.amazonaws.com/123456789012/kmitl-flood-jobs-staging"
S3_BUCKET_NAME="kmitl-flood-evidence-staging"
