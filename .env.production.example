# =============================================================================
# KMITL FLOOD INTELLIGENCE - PRODUCTION ENVIRONMENT CONFIGURATION
# STRICT RULE: NEVER COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO GIT!
# Inject values via AWS Secrets Manager / Parameter Store or Vault at runtime.
# =============================================================================

ENVIRONMENT=production
DEBUG=false
APP_NAME="KMITL Flood Intelligence"
APP_VERSION="1.0.0"
LOG_LEVEL=INFO

# Networking & Domains
DOMAIN=flood.kmitl.ac.th
API_DOMAIN=api.flood.kmitl.ac.th
PORT=8000
ALLOWED_ORIGINS="https://flood.kmitl.ac.th,https://www.flood.kmitl.ac.th"

# Database: AWS RDS Multi-AZ PostGIS Instance
DATABASE_URL="postgresql+asyncpg://kmitl_admin:REPLACE_WITH_SECURE_VAULT_PASSWORD@kmitl-flood-db-prod.cluster-xyz.ap-southeast-1.rds.amazonaws.com:5432/kmitl_flood_prod"
DATABASE_SYNC_URL="postgresql://kmitl_admin:REPLACE_WITH_SECURE_VAULT_PASSWORD@kmitl-flood-db-prod.cluster-xyz.ap-southeast-1.rds.amazonaws.com:5432/kmitl_flood_prod"
DB_POOL_SIZE=30
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis / Valkey: AWS ElastiCache Cluster
REDIS_URL="redis://kmitl-redis-prod.cluster-xyz.cache.amazonaws.com:6379/0"

# Async Job Queue: AWS SQS Queue URL
SQS_QUEUE_URL="https://sqs.ap-southeast-1.amazonaws.com/123456789012/kmitl-flood-jobs-production"

# Object Storage: AWS S3 Bucket for Verified Evidence
S3_BUCKET_NAME="kmitl-flood-evidence-production"
AWS_REGION="ap-southeast-1"

# Security & Tokens
SECRET_KEY="REPLACE_WITH_CRYPTOGRAPHICALLY_RANDOM_256BIT_SECRET"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External Environmental APIs (Official Production Credentials)
TMD_UID=""
TMD_UKEY=""
TRAFFY_API_KEY=""
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""

# Operational Boundaries (Lat Krabang & KMITL Campus)
MIN_LNG=100.6500
MIN_LAT=13.6500
MAX_LNG=100.9000
MAX_LAT=13.8200
DEFAULT_CENTER_LAT=13.7298
DEFAULT_CENTER_LNG=100.7782
DEFAULT_ZOOM=14
