# ==============================================================================
# KMITL FLOOD INTELLIGENCE - ENVIRONMENT VARIABLES CONFIGURATION
# Copy this file to .env before starting the services:
# cp .env.example .env
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="KMITL Flood Intelligence"
APP_VERSION="1.0.0"
DEBUG=true

# Database Configuration (PostgreSQL + PostGIS)
POSTGRES_USER=kmitl_flood_user
POSTGRES_PASSWORD=kmitl_flood_password_secure
POSTGRES_DB=kmitl_flood_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://kmitl_flood_user:kmitl_flood_password_secure@db:5432/kmitl_flood_db
DATABASE_SYNC_URL=postgresql://kmitl_flood_user:kmitl_flood_password_secure@db:5432/kmitl_flood_db

# Cache & Message Broker (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Security & CORS
SECRET_KEY=change_me_to_a_random_32_character_secret_string_in_production
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend & Frontend Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/live

# External Data Source Credentials (Optional in Phase 1 / Demo Mode)
# Leave blank to use respective Mock Providers with mode: DEMO
TMD_UID=
TMD_UKEY=
TRAFFY_API_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Geographic Constraints (Lat Krabang / KMITL Bounding Box)
MIN_LNG=100.6500
MIN_LAT=13.6500
MAX_LNG=100.9000
MAX_LAT=13.8200
DEFAULT_CENTER_LAT=13.7298
DEFAULT_CENTER_LNG=100.7782
DEFAULT_ZOOM=14
